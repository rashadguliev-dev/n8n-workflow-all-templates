{
  "name": "01_Sourcing_Amazon_Noon (Antigravity)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "minutes": 0
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0],
      "id": "trigger-node"
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { url: 'https://www.amazon.ae/s?k=iphone+15+pro', source: 'Amazon' } },\n  { json: { url: 'https://www.noon.com/uae-en/search?q=iphone%2015%20pro', source: 'Noon' } }\n];"
      },
      "name": "Define Target URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [200, 0],
      "id": "define-urls"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [400, 0],
      "id": "split-batches"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.scrapegraphai.com/v1/smartscraper",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "scrapeGraphAiApi",
        "sendBody": true,
        "bodyParametersJson": "={{ JSON.stringify({ url: $json.url, prompt: 'Extract product title, price, and availability status.' }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "name": "AI Scraper (Primary)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [600, -100],
      "id": "ai-scraper",
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.statusCode }}",
              "value2": 200
            }
          ]
        }
      },
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [800, 0],
      "id": "check-success"
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "waitForSelector": ".price"
        }
      },
      "name": "Puppeteer Scraper (Fallback)",
      "type": "n8n-nodes-base.puppeteer",
      "typeVersion": 1,
      "position": [1000, 150],
      "id": "puppeteer-fallback"
    },
    {
      "parameters": {
        "jsCode": "// Normalization Logic\nconst data = $input.all()[0].json;\nreturn {\n  title: data.title || data.product_name,\n  price: parseFloat((data.price || '0').replace(/[^0-9.]/g, '')),\n  source: $('Define Target URLs').item.json.source,\n  timestamp: new Date().toISOString()\n};"
      },
      "name": "Normalize Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 0],
      "id": "normalize-data"
    },
    {
      "parameters": {
        "workflowId": "02_Inventory_Sync"
      },
      "name": "Send to Inventory",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [1400, 0],
      "id": "send-inventory"
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [400, 400],
      "id": "error-trigger"
    },
    {
      "parameters": {
        "workflowId": "99_Error_Handler"
      },
      "name": "Log Error",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [600, 400],
      "id": "log-error"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Define Target URLs", "type": "main", "index": 0 }]]
    },
    "Define Target URLs": {
      "main": [[{ "node": "Split In Batches", "type": "main", "index": 0 }]]
    },
    "Split In Batches": {
      "main": [[{ "node": "AI Scraper (Primary)", "type": "main", "index": 0 }]]
    },
    "AI Scraper (Primary)": {
      "main": [[{ "node": "Check Success", "type": "main", "index": 0 }]]
    },
    "Check Success": {
      "main": [
        [{ "node": "Normalize Data", "type": "main", "index": 0 }],
        [{ "node": "Puppeteer Scraper (Fallback)", "type": "main", "index": 0 }]
      ]
    },
    "Puppeteer Scraper (Fallback)": {
      "main": [[{ "node": "Normalize Data", "type": "main", "index": 0 }]]
    },
    "Normalize Data": {
      "main": [[{ "node": "Send to Inventory", "type": "main", "index": 0 }]]
    },
    "Error Trigger": {
      "main": [[{ "node": "Log Error", "type": "main", "index": 0 }]]
    }
  }
}
