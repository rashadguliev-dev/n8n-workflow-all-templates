{
  "name": "02_DeenFlow_AI_Assistant",
  "nodes": [
    {
      "parameters": {
        "options": {}
      },
      "id": "1",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=## Role\nYou are DeenFlow Assistant, a knowledgeable and compassionate AI assistant grounded strictly in the Qur’an and Sahih Hadith, following the understanding of the Salaf (Athari methodology).\n\n## Core Philosophy\n- Simplicity over complexity.\n- Authentic sources only (Sahih Bukhari, Sahih Muslim, etc.).\n- No weak narrations.\n- No innovations (bid'ah).\n- Focus on daily action and connection to Allah.\n\n## Capabilities\n1. Explain Qur’an verses simply using authentic tafsir principles.\n2. Explain Sahih Hadith and how to apply them today.\n3. Give Islamic advice for daily life routines (morning, sleep, work).\n\n## Rules\n- ALWAYS reference the Qur’an or Sahih Hadith.\n- Never invent rulings.\n- If unsure, say \"Allah knows best\".\n- No speculation, philosophy, or sectarian arguments.\n- Maintain a calm, respectful, and encouraging tone.\n\n## Tools\n- Use 'Quran_Search' to find verses by query.\n- Use 'Hadith_Search' to find narrations by query."
        }
      },
      "id": "2",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {}
      },
      "id": "3",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        300,
        500
      ]
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "4",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1,
      "position": [
        500,
        500
      ]
    },
    {
      "parameters": {
        "name": "Quran_Search",
        "description": "Search for Quranic verses by keyword or topic.",
        "workflowId": "={{ $node[\"Quran Search Logic\"].id }}"
      },
      "id": "5",
      "name": "Quran Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1,
      "position": [
        650,
        400
      ]
    },
    {
      "parameters": {
        "name": "Hadith_Search",
        "description": "Search for authentic Hadiths from Bukhari/Muslim.",
        "workflowId": "={{ $node[\"Hadith Search Logic\"].id }}"
      },
      "id": "6",
      "name": "Hadith Search Tool",
      "type": "@n8n/n8n-nodes-langchain.toolWorkflow",
      "typeVersion": 1,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.alquran.cloud/v1/search/{{ $json.query }}/all/en.sahih",
        "options": {}
      },
      "id": "7",
      "name": "Quran Search Logic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        400
      ]
    },
    {
      "parameters": {
        "url": "https://api.hadith.gading.dev/books/bukhari?range=1-50",
        "options": {}
      },
      "id": "8",
      "name": "Hadith Search Logic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        850,
        200
      ]
    }
  ],
  "connections": {
    "Chat Trigger": {
